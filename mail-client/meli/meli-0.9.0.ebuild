src_configure() {
	local myfeatures=(
		$(usex dbus dbus-notifications "")
		$(usex gpg gpgme "")
		$(usev smtp)
		$(usev sqlite3)
		$(usev notmuch)
		$(usev jmap)
		$(usev static)
	)
	cargo_src_configure
}

src_install() {
	cargo_src_install --path ./meli

	"${D}/usr/bin/meli" man --gzipped meli.1 > meli.1.gz || die "Failed to generate meli.1 manpage"
	"${D}/usr/bin/meli" man --gzipped meli.conf.5 > meli.conf.5.gz || die "Failed to generate meli.conf.5 manpage"
	"${D}/usr/bin/meli" man --gzipped meli.conf.examples.5 > meli.conf.examples.5.gz || die "Failed to generate meli.conf.examples.5 manpage"
	"${D}/usr/bin/meli" man --gzipped meli-themes.5 > meli-themes.5.gz || die "Failed to generate meli-themes.5 manpage"
	"${D}/usr/bin/meli" man --gzipped meli.7 > meli.7.gz || die "Failed to generate meli.7 manpage"

	doman meli.1.gz \
		  meli.conf.5.gz \
		  meli.conf.examples.5.gz \
		  meli-themes.5.gz \
		  meli.7.gz
}
